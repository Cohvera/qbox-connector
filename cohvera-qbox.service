[Unit]
Description=Cohvera Q-box Plenion connector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=/etc/cohvera-qbox/qbox.env
ExecStart=/usr/bin/python3 /opt/cohvera-qbox/qbox_sync.py
StateDirectory=cohvera-qbox
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077

[Install]
WantedBy=multi-user.target
