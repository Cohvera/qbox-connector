# Full Data Hub API: all current project versions with original status and closure flag.
QBOX_SOURCE_MODE=datahub
QBOX_DATAHUB_URL=http://192.168.10.228:3210
# Legacy TV URL, only used when QBOX_SOURCE_MODE=tv.
QBOX_SOURCE_URL=http://www.tomme-energie.lan/projecten-tv
# Not needed for HTTP on the LAN. For HTTPS use the issuing CA certificate (PEM).
QBOX_SOURCE_CA_FILE=
QBOX_PORTAL_URL=https://portal.cohvera.be
QBOX_IMPORT_API_KEY=
QBOX_POLL_SECONDS=60
QBOX_STATE_FILE=/var/lib/cohvera-qbox/state.json

# Optionele widgets voor het Cohvera-tv-scherm (na deployment van de tv-migratie).
QBOX_TV_ENABLED=0
# Alleen invullen als deze read-only route vanaf de Q-box bereikbaar is.
QBOX_NAS_URL=
